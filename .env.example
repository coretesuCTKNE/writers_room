# Greenlight — Environment Variables

# API bind (local-only by default)
API_HOST=127.0.0.1
PORT=8000

# Google AI — set EITHER GOOGLE_API_KEY (simplest for local dev) OR Vertex project
# Auth: gcloud auth application-default login (Vertex dev) or
#       GOOGLE_APPLICATION_CREDENTIALS=/path/sa-key.json (Docker/deploy)
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# TTS preview models are regional — us-central1 has widest coverage
TTS_CLOUD_LOCATION=us-central1

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=greenlight
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Audio storage — empty = local disk (generated_audio/); bucket name = upload
# WAVs to GCS and serve public object URLs (Cloud Run mode)
# GCS_BUCKET=greenlight-audio

# Firebase Auth (anonymous) — empty = auth off, principal "local" (dev + tests).
# Set on the deployed instance; frontend config lives in web/.env.production.
# FIREBASE_PROJECT_ID=greenlight15488

# Experimental routes (off by default)
# GREENLIGHT_ENABLE_PROTO=true

# Grafana Cloud (optional — P1)
# OTEL_EXPORTER_OTLP_ENDPOINT=
# GRAFANA_STACK_URL=
# GRAFANA_SERVICE_TOKEN=
# GRAFANA_CLICKHOUSE_UID=            # pre-baked datasource UID (saves a tool hop)
# GRAFANA_PUBLIC_DASHBOARD_URL=      # public Story Ops dashboard; empty = hide button

# Workspace MCP Drive (optional — P2)
# INGEST_DRIVE_FOLDER_ID=
